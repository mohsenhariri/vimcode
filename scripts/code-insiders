#!/usr/bin/env bash
set -euo pipefail

script_source="${BASH_SOURCE[0]}"

if command -v readlink >/dev/null 2>&1; then
  script_source="$(readlink -f "$script_source")"
fi

script_dir="$(cd -- "$(dirname -- "$script_source")" && pwd -P)"

exec "$script_dir/vimium-code-launcher.sh" code-insiders "$@"
