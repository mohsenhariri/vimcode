      { "command": "vimiumCode.ignoreUnassignedKey", "key": "numpad_multiply" },
      { "command": "vimiumCode.ignoreUnassignedKey", "key": "numpad_decimal" },
      {
        "command": "vimiumCode.openWorkbenchHints",
        "key": "f",
        "when": "(listFocus || statusBarFocused) && !inputFocus && !editorTextFocus && !inQuickOpen && !terminalFocus && !notebookEditorFocused",
        "args": {
          "force": false
        }
      },
      {
        "command": "vimiumCode.openWorkbenchHints",
        "key": "shift+f",
        "when": "(listFocus || statusBarFocused) && !inputFocus && !editorTextFocus && !inQuickOpen && !terminalFocus && !notebookEditorFocused",
        "args": {
          "force": false
        }
      },
      {
        "command": "vimiumCode.enterHintMode",
        "key": "alt+j",
        "args": {
          "editorFocused": true
        },
        "when": "editorTextFocus && !focusedView && !inChatInput && !isInEmbeddedEditor && !inQuickOpen && !vimiumCode.hintMode"
      },
      {
        "command": "vimiumCode.openWorkbenchHints",
        "key": "alt+j",
        "when": "!editorTextFocus && !inQuickOpen && !terminalFocus",
        "args": {
          "force": true
        }
      },
      {
        "command": "runCommands",
        "key": "alt+j",
        "when": "terminalFocus && !inQuickOpen",
        "args": {
          "commands": [{ "command": "vimiumCode.openWorkbenchHints", "args": { "force": true } }]
        }
      },
      {
        "command": "vimiumCode.enterCommandMode",
        "key": "escape",
        "when": "editorTextFocus && !focusedView && !inChatInput && !isInEmbeddedEditor && !inQuickOpen && !vimiumCode.commandMode && !vimiumCode.hintMode && !suggestWidgetVisible && !parameterHintsVisible && !renameInputVisible && !inSnippetMode && !findWidgetVisible && !referenceSearchVisible && !inlineSuggestionVisible && !editorHasSelection && !editorHasMultipleSelections && !vim.active && !isComposing && !inlineEditIsVisible && !inlineChatFocused && !notebookEditorFocused && !editorHoverVisible && !vimiumCode.nativeModeSwitch"
      },
      {
        "command": "runCommands",
        "key": "escape",
        "when": "editorTextFocus && !focusedView && !inChatInput && !isInEmbeddedEditor && !inQuickOpen && !vimiumCode.commandMode && !vimiumCode.hintMode && !suggestWidgetVisible && !parameterHintsVisible && !renameInputVisible && !inSnippetMode && !findWidgetVisible && !referenceSearchVisible && !inlineSuggestionVisible && !editorHasSelection && !editorHasMultipleSelections && !vim.active && !isComposing && !inlineEditIsVisible && !inlineChatFocused && !notebookEditorFocused && !editorHoverVisible && vimiumCode.nativeModeSwitch",
        "args": {
          "commands": [
            {
              "command": "_setContext",
              "args": [
                "vimiumCode.commandMode",
                true
              ]
            },
            {
              "command": "vimiumCode.enterCommandMode",
              "args": {
                "contextSet": true
              }
            }
          ]
        }
      },
      {
        "command": "vimiumCode.exitCommandMode",
        "key": "escape",
        "when": "editorTextFocus && !focusedView && !inChatInput && !isInEmbeddedEditor && !inQuickOpen && vimiumCode.commandMode && !vimiumCode.hintMode && !vimiumCode.nativeModeSwitch"
      },
      {
        "command": "runCommands",
        "key": "escape",
        "when": "editorTextFocus && !focusedView && !inChatInput && !isInEmbeddedEditor && !inQuickOpen && vimiumCode.commandMode && !vimiumCode.hintMode && vimiumCode.nativeModeSwitch",
        "args": {
          "commands": [
            {
              "command": "_setContext",
              "args": [
                "vimiumCode.commandMode",
                false
              ]
            },
            {
              "command": "vimiumCode.exitCommandMode",
              "args": {
                "contextSet": true
              }
            }
          ]
        }
      },
      {
        "command": "vimiumCode.openWorkbenchHints",
        "key": "f",
        "args": { "force": true },
        "when": "editorTextFocus && !focusedView && !inChatInput && !isInEmbeddedEditor && !inQuickOpen && vimiumCode.commandMode && !vimiumCode.hintMode"
      },
      {
        "command": "vimiumCode.openWorkbenchHints",
        "key": "shift+f",
        "args": { "force": true },
        "when": "editorTextFocus && !focusedView && !inChatInput && !isInEmbeddedEditor && !inQuickOpen && vimiumCode.commandMode && !vimiumCode.hintMode"
      },
      {
        "command": "vimiumCode.enterHintMode",
        "key": "g f",
        "args": {
          "editorFocused": true
        },
        "when": "editorTextFocus && !focusedView && !inChatInput && !isInEmbeddedEditor && !inQuickOpen && vimiumCode.commandMode && !vimiumCode.hintMode"
      },
      {
        "command": "vimiumCode.exitCommandMode",
        "key": "i",
        "when": "editorTextFocus && !focusedView && !inChatInput && !isInEmbeddedEditor && !inQuickOpen && vimiumCode.commandMode && !vimiumCode.hintMode && !vimiumCode.nativeModeSwitch"
      },
      {
        "command": "runCommands",
        "key": "i",
        "when": "editorTextFocus && !focusedView && !inChatInput && !isInEmbeddedEditor && !inQuickOpen && vimiumCode.commandMode && !vimiumCode.hintMode && vimiumCode.nativeModeSwitch",
        "args": {
          "commands": [
            {
              "command": "_setContext",
              "args": [
                "vimiumCode.commandMode",
                false
              ]
            },
            {
              "command": "vimiumCode.exitCommandMode",
              "args": {
                "contextSet": true
              }
            }
          ]
        }
      },
      {
        "command": "vimiumCode.exitCommandMode",
        "key": "a",
        "when": "editorTextFocus && !focusedView && !inChatInput && !isInEmbeddedEditor && !inQuickOpen && vimiumCode.commandMode && !vimiumCode.hintMode && !vimiumCode.nativeModeSwitch",
        "args": {
          "action": "cursorRight"
        }
      },
      {
        "command": "runCommands",
        "key": "a",
        "when": "editorTextFocus && !focusedView && !inChatInput && !isInEmbeddedEditor && !inQuickOpen && vimiumCode.commandMode && !vimiumCode.hintMode && vimiumCode.nativeModeSwitch",
        "args": {
          "commands": [
            {
              "command": "_setContext",
              "args": [
                "vimiumCode.commandMode",
                false
              ]
