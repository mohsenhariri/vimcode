    "configuration": {
      "title": "Vimium for VS Code",
      "properties": {
        "vimiumCode.hintCharacters": {
          "type": "string",
          "default": "asdfghjklqwertyuiopzxcvbnm",
          "pattern": "^[a-zA-Z0-9]+$",
          "description": "Characters used to generate hint labels. Duplicate characters are ignored. Only letters and digits have default keybindings."
        },
        "vimiumCode.maxEditorHints": {
          "type": "integer",
          "default": 250,
          "minimum": 1,
          "maximum": 1000,
          "description": "Maximum number of visible editor lines to label in one hint session."
        },
        "vimiumCode.includeBlankLines": {
          "type": "boolean",
          "default": false,
          "description": "Include blank visible editor lines as jump targets."
        },
        "vimiumCode.autoAcceptExactHint": {
          "type": "boolean",
          "default": true,
          "description": "Jump immediately after the typed hint exactly matches a target label."
        },
        "vimiumCode.preferWorkbenchDomOverlay": {
          "scope": "machine",
          "type": "boolean",
          "default": true,
          "description": "Try experimental Vimium-style DOM labels over the VS Code workbench when VS Code is launched with the configured remote debugging port. Falls back to the supported IDE hint list when unavailable."
        },
        "vimiumCode.workbenchDomOverlayDebugPort": {
          "scope": "machine",
          "type": "integer",
          "default": 9333,
          "minimum": 1,
          "maximum": 65535,
          "description": "Local Chrome DevTools Protocol port used by experimental workbench DOM hints. Start VS Code with --remote-debugging-port=<port> to enable direct DOM overlays."
        }
      }
    }
