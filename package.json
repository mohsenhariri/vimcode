{
  "name": "vimcode",
  "displayName": "VimCode",
  "description": "Keyboard-first editor and IDE navigation hints for VS Code, inspired by Vimium.",
  "version": "0.3.2",
  "publisher": "harimo9",
  "license": "MIT",
  "icon": "images/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/mohsenhariri/vimcode.git"
  },
  "bugs": {
    "url": "https://github.com/mohsenhariri/vimcode/issues"
  },
  "homepage": "https://mohsenhariri.github.io/vimcode/",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Keymaps",
    "Other"
  ],
  "keywords": [
    "vim",
    "vimium",
    "keyboard",
    "navigation",
    "hints"
  ],
  "extensionKind": [
    "ui"
  ],
  "files": [
    "dist/extension.js",
    "images/icon.png",
    "scripts/code",
    "scripts/code-insiders",
    "scripts/vimium-code-launcher.sh",
    "README.md",
    "CHANGELOG.md",
    "KNOWN_ISSUES.md",
    "LICENSE"
  ],
  "main": "./dist/extension.js",
  "vsce": {
    "dependencies": false
  },
  "activationEvents": [
    "onStartupFinished",
    "onCommand:vimiumCode.enterHintMode",
    "onCommand:vimiumCode.openWorkbenchHints",
    "onCommand:vimiumCode.typeHintCharacter",
    "onCommand:vimiumCode.acceptHint",
    "onCommand:vimiumCode.backspaceHint",
    "onCommand:vimiumCode.cancelHint",
    "onCommand:vimiumCode.enterCommandMode",
    "onCommand:vimiumCode.exitCommandMode",
    "onCommand:vimiumCode.scrollDown",
    "onCommand:vimiumCode.scrollUp",
    "onCommand:vimiumCode.pageDown",
    "onCommand:vimiumCode.pageUp",
    "onCommand:vimiumCode.goToTop",
    "onCommand:vimiumCode.goToBottom",
    "onCommand:vimiumCode.focusNextEditor",
    "onCommand:vimiumCode.focusPreviousEditor",
    "onCommand:vimiumCode.focusExplorer",
    "onCommand:vimiumCode.focusSearch",
    "onCommand:vimiumCode.focusSourceControl",
    "onCommand:vimiumCode.focusRunAndDebug",
    "onCommand:vimiumCode.focusExtensions",
    "onCommand:vimiumCode.focusActivityBar",
    "onCommand:vimiumCode.focusSideBar",
    "onCommand:vimiumCode.focusFilesExplorer",
    "onCommand:vimiumCode.revealActiveFileInExplorer",
    "onCommand:vimiumCode.explorerNewFile",
    "onCommand:vimiumCode.explorerNewFolder",
    "onCommand:vimiumCode.explorerRefresh",
    "onCommand:vimiumCode.explorerCollapseAll",
    "onCommand:vimiumCode.listFocusUp",
    "onCommand:vimiumCode.listFocusDown",
    "onCommand:vimiumCode.listExpand",
    "onCommand:vimiumCode.listCollapse",
    "onCommand:vimiumCode.listSelect",
    "onCommand:vimiumCode.focusPanel",
    "onCommand:vimiumCode.focusStatusBar",
    "onCommand:vimiumCode.toggleSideBar",
    "onCommand:vimiumCode.togglePanel",
    "onCommand:vimiumCode.toggleTerminal",
    "onCommand:vimiumCode.ignoreUnassignedKey"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    },
    "virtualWorkspaces": true
  },
  "contributes": {
    "commands": [
      {
        "command": "vimiumCode.enterHintMode",
        "title": "Show Editor Navigation Hints",
        "category": "Vimium"
      },
      {
        "command": "vimiumCode.openWorkbenchHints",
        "title": "Show IDE Navigation Hints",
        "category": "Vimium"
      },
      {
        "command": "vimiumCode.typeHintCharacter",
        "title": "Type Hint Character",
        "category": "Vimium",
        "enablement": "editorTextFocus && !focusedView && !inChatInput && !isInEmbeddedEditor && !inQuickOpen && vimiumCode.hintMode"
      },
      {
        "command": "vimiumCode.acceptHint",
        "title": "Accept Hint",
        "category": "Vimium"
      },
      {
        "command": "vimiumCode.backspaceHint",
        "title": "Delete Hint Character",
        "category": "Vimium"
      },
      {
        "command": "vimiumCode.cancelHint",
        "title": "Cancel Hint Mode",
        "category": "Vimium"
      },
      {
        "command": "vimiumCode.enterCommandMode",
        "title": "Enter Editor Command Mode",
        "category": "Vimium"
      },
      {
        "command": "vimiumCode.exitCommandMode",
        "title": "Exit Editor Command Mode",
        "category": "Vimium"
      },
      {
        "command": "vimiumCode.scrollDown",
        "title": "Scroll Down",
        "category": "Vimium"
      },
      {
        "command": "vimiumCode.scrollUp",
        "title": "Scroll Up",
        "category": "Vimium"
      },
      {
        "command": "vimiumCode.pageDown",
        "title": "Page Down",
        "category": "Vimium"
      },
      {
        "command": "vimiumCode.pageUp",
        "title": "Page Up",
        "category": "Vimium"
      },
      {
        "command": "vimiumCode.goToTop",
        "title": "Go to Top",
        "category": "Vimium"
      },
      {
        "command": "vimiumCode.goToBottom",
        "title": "Go to Bottom",
        "category": "Vimium"
      },
      {
        "command": "vimiumCode.focusNextEditor",
        "title": "Focus Next Editor",
        "category": "Vimium"
      },
      {
        "command": "vimiumCode.focusPreviousEditor",
        "title": "Focus Previous Editor",
        "category": "Vimium"
      },
      {
        "command": "vimiumCode.focusExplorer",
        "title": "Focus Explorer",
        "category": "Vimium"
      },
      {
        "command": "vimiumCode.focusSearch",
        "title": "Focus Search",
        "category": "Vimium"
      },
      {
        "command": "vimiumCode.focusSourceControl",
        "title": "Focus Source Control",
        "category": "Vimium"
      },
      {
        "command": "vimiumCode.focusRunAndDebug",
        "title": "Focus Run and Debug",
        "category": "Vimium"
      },
      {
        "command": "vimiumCode.focusExtensions",
        "title": "Focus Extensions",
        "category": "Vimium"
      },
      {
        "command": "vimiumCode.focusActivityBar",
        "title": "Focus Activity Bar",
        "category": "Vimium"
      },
      {
        "command": "vimiumCode.focusSideBar",
        "title": "Focus Side Bar",
        "category": "Vimium"
      },
      {
        "command": "vimiumCode.focusFilesExplorer",
        "title": "Focus Files Explorer",
        "category": "Vimium"
      },
      {
        "command": "vimiumCode.revealActiveFileInExplorer",
        "title": "Reveal Active File in Explorer",
        "category": "Vimium"
      },
      {
        "command": "vimiumCode.explorerNewFile",
        "title": "Explorer: New File",
        "category": "Vimium"
      },
      {
        "command": "vimiumCode.explorerNewFolder",
        "title": "Explorer: New Folder",
        "category": "Vimium"
      },
      {
        "command": "vimiumCode.explorerRefresh",
        "title": "Explorer: Refresh",
        "category": "Vimium"
      },
      {
        "command": "vimiumCode.explorerCollapseAll",
        "title": "Explorer: Collapse All",
        "category": "Vimium"
      },
      {
        "command": "vimiumCode.listFocusUp",
        "title": "List: Focus Previous Item",
        "category": "Vimium"
      },
      {
        "command": "vimiumCode.listFocusDown",
        "title": "List: Focus Next Item",
        "category": "Vimium"
      },
      {
        "command": "vimiumCode.listExpand",
        "title": "List: Expand Item",
        "category": "Vimium"
      },
      {
        "command": "vimiumCode.listCollapse",
        "title": "List: Collapse Item",
        "category": "Vimium"
      },
      {
        "command": "vimiumCode.listSelect",
        "title": "List: Select Item",
        "category": "Vimium"
      },
      {
        "command": "vimiumCode.focusPanel",
        "title": "Focus Panel",
        "category": "Vimium"
      },
      {
        "command": "vimiumCode.focusStatusBar",
        "title": "Focus Status Bar",
        "category": "Vimium"
      },
      {
        "command": "vimiumCode.toggleSideBar",
        "title": "Toggle Side Bar",
        "category": "Vimium"
      },
      {
        "command": "vimiumCode.togglePanel",
        "title": "Toggle Panel",
        "category": "Vimium"
      },
      {
        "command": "vimiumCode.toggleTerminal",
        "title": "Toggle Terminal",
        "category": "Vimium"
      },
      {
        "command": "vimiumCode.ignoreUnassignedKey",
        "title": "Ignore Unassigned Navigation Key",
        "category": "Vimium",
        "enablement": "editorTextFocus && !focusedView && !inChatInput && !isInEmbeddedEditor && !inQuickOpen && (vimiumCode.commandMode || vimiumCode.hintMode)"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "vimiumCode.typeHintCharacter",
          "when": "false"
        },
        {
          "command": "vimiumCode.acceptHint",
          "when": "false"
        },
        {
          "command": "vimiumCode.backspaceHint",
          "when": "false"
        },
        {
          "command": "vimiumCode.cancelHint",
          "when": "false"
        },
        {
          "command": "vimiumCode.exitCommandMode",
          "when": "false"
        },
        {
          "command": "vimiumCode.ignoreUnassignedKey",
          "when": "false"
        }
      ]
    },
    "keybindings": [
