    "menus": {
      "commandPalette": [
        {
          "command": "vimiumCode.typeHintCharacter",
          "when": "false"
        },
        {
          "command": "vimiumCode.acceptHint",
          "when": "false"
        },
        {
          "command": "vimiumCode.backspaceHint",
          "when": "false"
        },
        {
          "command": "vimiumCode.cancelHint",
          "when": "false"
        },
        {
          "command": "vimiumCode.exitCommandMode",
          "when": "false"
        }
      ]
    },
    "keybindings": [
      {
        "command": "vimiumCode.openWorkbenchHints",
        "key": "f",
        "when": "!editorTextFocus && !editorAreaFocus && !inputFocus && !terminalFocus && !webviewId && !vimiumCode.hintMode",
        "args": {
          "force": false
        }
      },
      {
        "command": "vimiumCode.openWorkbenchHints",
        "key": "shift+f",
        "when": "!editorTextFocus && !editorAreaFocus && !inputFocus && !terminalFocus && !webviewId && !vimiumCode.hintMode",
        "args": {
          "force": false
        }
      },
      {
        "command": "vimiumCode.enterHintMode",
        "key": "alt+j",
        "when": "editorTextFocus && !vimiumCode.hintMode"
      },
      {
        "command": "vimiumCode.openWorkbenchHints",
        "key": "alt+j",
        "when": "webviewId && !vimiumCode.hintMode",
        "args": {
          "force": true
        }
      },
      {
        "command": "vimiumCode.enterCommandMode",
        "key": "escape",
        "when": "editorTextFocus && !vimiumCode.commandMode && !vimiumCode.hintMode && !suggestWidgetVisible && !parameterHintsVisible && !renameInputVisible && !inSnippetMode && !findWidgetVisible && !referenceSearchVisible && !inlineSuggestionVisible && !editorHasSelection && !editorHasMultipleSelections"
      },
      {
        "command": "vimiumCode.exitCommandMode",
        "key": "escape",
        "when": "editorTextFocus && vimiumCode.commandMode && !vimiumCode.hintMode"
      },
      {
        "command": "vimiumCode.openWorkbenchHints",
        "key": "f",
        "when": "editorTextFocus && vimiumCode.commandMode && !vimiumCode.hintMode"
      },
      {
        "command": "vimiumCode.openWorkbenchHints",
        "key": "shift+f",
        "when": "editorTextFocus && vimiumCode.commandMode && !vimiumCode.hintMode"
      },
      {
        "command": "vimiumCode.enterHintMode",
        "key": "g f",
        "when": "editorTextFocus && vimiumCode.commandMode && !vimiumCode.hintMode"
      },
      {
        "command": "vimiumCode.exitCommandMode",
        "key": "i",
        "when": "editorTextFocus && vimiumCode.commandMode && !vimiumCode.hintMode"
      },
      {
        "command": "vimiumCode.exitCommandMode",
        "key": "a",
        "when": "editorTextFocus && vimiumCode.commandMode && !vimiumCode.hintMode",
        "args": {
          "action": "cursorRight"
        }
      },
      {
        "command": "vimiumCode.exitCommandMode",
        "key": "o",
        "when": "editorTextFocus && vimiumCode.commandMode && !vimiumCode.hintMode",
        "args": {
          "action": "editor.action.insertLineAfter"
        }
      },
      {
        "command": "cursorLeft",
        "key": "h",
        "when": "editorTextFocus && vimiumCode.commandMode && !vimiumCode.hintMode"
      },
      {
        "command": "cursorDown",
        "key": "j",
        "when": "editorTextFocus && vimiumCode.commandMode && !vimiumCode.hintMode"
      },
      {
        "command": "cursorUp",
        "key": "k",
        "when": "editorTextFocus && vimiumCode.commandMode && !vimiumCode.hintMode"
      },
      {
        "command": "cursorRight",
        "key": "l",
        "when": "editorTextFocus && vimiumCode.commandMode && !vimiumCode.hintMode"
      },
      {
        "command": "cursorLeft",
        "key": "backspace",
        "when": "editorTextFocus && vimiumCode.commandMode && !vimiumCode.hintMode"
      },
      {
        "command": "vimiumCode.goToTop",
        "key": "g g",
        "when": "editorTextFocus && vimiumCode.commandMode && !vimiumCode.hintMode"
      },
      {
        "command": "vimiumCode.goToBottom",
        "key": "shift+g",
        "when": "editorTextFocus && vimiumCode.commandMode && !vimiumCode.hintMode"
      },
      {
        "command": "vimiumCode.cancelHint",
        "key": "escape",
        "when": "vimiumCode.hintMode"
      },
      {
        "command": "vimiumCode.acceptHint",
        "key": "enter",
        "when": "vimiumCode.hintMode"
      },
      {
        "command": "vimiumCode.backspaceHint",
        "key": "backspace",
        "when": "vimiumCode.hintMode"
      },
      {
        "command": "vimiumCode.scrollDown",
        "key": "ctrl+d",
        "when": "editorTextFocus && vimiumCode.commandMode && !vimiumCode.hintMode"
      },
      {
        "command": "vimiumCode.scrollUp",
        "key": "ctrl+u",
        "when": "editorTextFocus && vimiumCode.commandMode && !vimiumCode.hintMode"
      },
      {
        "command": "vimiumCode.listFocusDown",
        "key": "j",
        "when": "listFocus && !editorTextFocus && !inputFocus && !vimiumCode.hintMode"
      },
      {
        "command": "vimiumCode.listFocusUp",
        "key": "k",
        "when": "listFocus && !editorTextFocus && !inputFocus && !vimiumCode.hintMode"
      },
      {
        "command": "vimiumCode.listCollapse",
        "key": "h",
