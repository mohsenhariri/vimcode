      {
        "command": "vimiumCode.listExpand",
        "key": "l",
        "when": "listFocus && !editorTextFocus && !inputFocus && !vimiumCode.hintMode"
      },
      {
        "command": "vimiumCode.listSelect",
        "key": "enter",
        "when": "listFocus && !editorTextFocus && !inputFocus && !vimiumCode.hintMode"
      },
      {
        "command": "vimiumCode.focusExplorer",
        "key": "g e",
        "when": "!editorTextFocus && !editorAreaFocus && !inputFocus && !terminalFocus && !webviewId && !vimiumCode.hintMode"
